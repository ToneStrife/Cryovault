# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# La clave anon/publishable es pública por diseño (va en el bundle), pero conviene
# no fijarla en el código para poder cambiar de proyecto sin tocar fuentes.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON
